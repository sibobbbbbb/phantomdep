{
  "name": "phantomdep-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first, zero-infra slopsquatting guard for the agentic era",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "clean": "pnpm -r exec rimraf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
